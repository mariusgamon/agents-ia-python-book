# Copiez ce fichier en .env puis renseignez vos clés :  cp .env.example .env
# Le .env n'est jamais commité (voir .gitignore).

# === Obligatoire (tous les jours) ===
OPENAI_API_KEY=sk-proj-votre-clé-ici
DEFAULT_MODEL=gpt-5.4-mini
LOG_LEVEL=INFO

# Désactive l'envoi des traces à OpenAI (RGPD — voir §5.5)
# OPENAI_AGENTS_DISABLE_TRACING=1

# === Jour 2 / 5 — agent météo, tools/weather.py ===
OPENWEATHER_API_KEY=

# === Jour 5 — observabilité (optionnel) ===
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LOGFIRE_TOKEN=

# === Jour 6 — API FastAPI (aussi dans day6/.env.example) ===
API_SECRET_KEY=change-me-in-production

# === Jour 7 — cas pratiques ===
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=

# === Bonus « from scratch » (annexe B) ===
MISTRAL_API_KEY=

# === Annexe C — multi-provider ===
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENROUTER_API_KEY=sk-or-...
# LLM_PROVIDER=openai   # ou anthropic (multi_provider_langgraph.py)
